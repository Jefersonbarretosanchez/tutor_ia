# Copiar a .env y completar antes de desplegar. Nunca commitear el .env real.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lti-chat.tudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lti-chat.tudominio.com
DJANGO_LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL autoadministrado, ver sección 9 del alcance) ---
DATABASE_URL=postgres://lti_chat:CAMBIA_ESTO@127.0.0.1:5432/lti_chat_scala

# --- Cache (Redis) — requerido en producción con más de un worker de Gunicorn ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Token corto del widget de chat ---
LAUNCH_TOKEN_SECRET=otra-clave-larga-y-aleatoria-distinta-de-DJANGO_SECRET_KEY
LAUNCH_TOKEN_TTL_SECONDS=5400

# --- LTI 1.3 ---
# Dominio(s) de Canvas que pueden embeber el chat en un iframe, separados por coma.
LTI_FRAME_ANCESTORS=https://tuinstitucion.instructure.com
LTI_TOOL_PRIVATE_KEY_PATH=/srv/lti-chat/keys/lti_tool_private.pem
LTI_TOOL_PUBLIC_KEY_PATH=/srv/lti-chat/keys/lti_tool_public.pem

# --- Control de tokens ---
DEFAULT_COURSE_TOKEN_LIMIT=200000
TOKEN_WARNING_THRESHOLD_PCT=80
N8N_REQUEST_TIMEOUT_SECONDS=40
CHAT_HISTORY_TURNS=8

# --- Webhooks fijos de Clara (apertura de momento + turno de conversación) ---
CLARA_APERTURA_URL=https://scalalearning3.app.n8n.cloud/webhook/clara/apertura
CLARA_RESPONDER_URL=https://scalalearning3.app.n8n.cloud/webhook/clara/responder
CLARA_REQUEST_TIMEOUT_SECONDS=40
CLARA_COURSE_ID=toma_decisiones

# --- API REST de Canvas (para "Asignar acceso" de páginas por estudiante) ---
# Token distinto del Developer Key LTI: Personal Access Token (o Developer
# Key OAuth2 propio) con permiso de edición de curso en tu instancia de Canvas.
CANVAS_API_BASE_URL=https://uandinavirtual.instructure.com
CANVAS_API_TOKEN=cambia-esto-por-un-token-de-canvas-con-permiso-de-edicion-de-curso
CANVAS_API_TIMEOUT_SECONDS=15

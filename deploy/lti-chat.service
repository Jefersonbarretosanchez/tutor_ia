[Unit]
Description=Gunicorn - LTI Chat Scala
After=network.target postgresql.service

[Service]
User=ltiapp
Group=ltiapp
WorkingDirectory=/srv/lti-chat
EnvironmentFile=/srv/lti-chat/.env
ExecStart=/srv/lti-chat/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/srv/lti-chat/run/gunicorn.sock \
    --access-logfile - \
    --error-logfile - \
    config.wsgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
